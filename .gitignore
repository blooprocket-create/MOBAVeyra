# Python bytecode caches (Docs tooling, scripts, tests).
__pycache__/
*.py[cod]

# OS and editor junk.
.DS_Store
Thumbs.db

# Unreal Engine generated output (regenerable; never source).
Binaries/
Intermediate/
Saved/
DerivedDataCache/
.vs/
*.sln
*.slnx
.vsconfig
*.VC.db

# Unreal binary assets under Game/ go through Git LFS: the patterns and the
# locking convention live in .gitattributes, as decided in
