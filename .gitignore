# Python bytecode caches (Docs tooling, scripts, tests).
__pycache__/
*.py[cod]

# OS and editor junk.
.DS_Store
Thumbs.db

# Unreal Engine generated output (regenerable; never source).
Binaries/
Intermediate/
Saved/
DerivedDataCache/
# Cook logs BuildCookRun writes next to the project.
Game/Build/*/FileOpenOrder/
.vs/
*.sln
*.slnx
.vsconfig
*.VC.db

# Unreal binary assets under Game/ go through Git LFS: the patterns and the
# locking convention live in .gitattributes, as decided in
# Docs/ADR/ADR-006-unreal-project-scaffold.md §9.

# The launcher's Rust build output, and what tauri-build writes beside its sources.
Launcher/target/
Launcher/app/icons/
Launcher/app/gen/

# The config Smoke.ps1 and Play.ps1 -Opponent write for a scripted match's backend.
Backend/config/scripted.json
# The config Game/Scripts/Host.ps1 writes from public.json with this PC's public address (ADR-057).
Backend/config/hosted.json
