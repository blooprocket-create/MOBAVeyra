// The Cloudflare Worker that the repository's Workers Builds deploy (see Website/README.md). Its name must stay
// the connected Worker's, "veyra".
{
  "name": "veyra",
  "main": "Website/worker.js",
  "compatibility_date": "2025-09-01",
  // A branch other than the production branch builds a Preview (npx wrangler preview), which needs this block even
  // when empty: a Preview takes none of the production settings above unless they are repeated here.
  "previews": {}
}
