{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Abilities tuning",
  "description": "Gameplay tuning owned by the Abilities domain: the statuses abilities apply and each ability's numbers, keyed by content ID and grouped by archetype (ADR-008 §3). VeyraAbilities binds it to FVeyraAbilitiesTuning. A list whose name ends \"ByRank\" holds one value for every rank, or one value per rank.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "casting", "statuses", "targetedDamage", "area", "selfBuff"],
  "definitions": {
    "provenance": {
      "description": "Where these values come from (ADR-008 §7).",
      "type": "string",
      "enum": ["Provisional", "Canon", "Reviewed"]
    },
    "byRank": {
      "description": "One value for every rank, or one value per rank (5 for a basic ability, 3 for an ultimate).",
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "minimum": 0 }
    },
    "statusIds": {
      "description": "Statuses from /statuses, by ID.",
      "type": "array",
      "minItems": 0,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" }
    },
    "cast": {
      "description": "How a cast is timed and paid for (Combat Bible §26, §27, §48; ADR-008 §4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["cooldownSecondsByRank", "resourceCostByRank", "castRange", "windupSeconds", "windupMovement", "recoverySeconds"],
      "properties": {
        "cooldownSecondsByRank": { "description": "Cooldown in seconds, starting at Commit.", "$ref": "#/definitions/byRank" },
        "resourceCostByRank": { "description": "Resource paid at Commit.", "$ref": "#/definitions/byRank" },
        "castRange": {
          "description": "How far from the caster the cast's ground point may be, in units; a point beyond it is brought back within it (ADR-008 §9). 0 for an ability that needs no point.",
          "type": "number",
          "minimum": 0
        },
        "windupSeconds": {
          "description": "Seconds before Commit. An interruption during them costs nothing and starts part of the cooldown (Combat Bible §26).",
          "type": "number",
          "minimum": 0
        },
        "windupMovement": {
          "description": "Whether the caster may move during the windup (Combat Bible §48).",
          "type": "string",
          "enum": ["Free", "Locked"]
        },
        "recoverySeconds": {
          "description": "Seconds after delivery before the caster may cast again.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "damage": {
      "description": "One damage component: its amount at the caster's rank plus the caster's power times the ratios, fixed at Commit (Combat Bible §25, §50).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amountByRank", "physicalPowerRatio", "magicPowerRatio"],
      "properties": {
        "type": { "type": "string", "enum": ["Physical", "Magic", "TrueDamage"] },
        "amountByRank": { "$ref": "#/definitions/byRank" },
        "physicalPowerRatio": { "type": "number", "minimum": 0 },
        "magicPowerRatio": { "type": "number", "minimum": 0 }
      }
    },
    "displacement": {
      "description": "A Knockback or Pull of each unit hit (Combat Bible §9). Displacement Resistance shortens it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "distance", "speed"],
      "properties": {
        "direction": { "type": "string", "enum": ["TowardOrigin", "AwayFromOrigin", "AcrossCastLeft", "AcrossCastRight"] },
        "distance": { "description": "Units; a Pull toward the origin stops there.", "type": "number", "minimum": 0, "exclusiveMinimum": true },
        "speed": { "description": "Units per second.", "type": "number", "minimum": 0, "exclusiveMinimum": true }
      }
    },
    "effects": {
      "description": "What happens to each unit hit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["damage", "statuses", "displacement"],
      "properties": {
        "damage": { "type": "array", "minItems": 0, "maxItems": 3, "items": { "$ref": "#/definitions/damage" } },
        "statuses": { "$ref": "#/definitions/statusIds" },
        "displacement": { "type": "array", "minItems": 0, "maxItems": 1, "items": { "$ref": "#/definitions/displacement" } }
      }
    },
    "shape": {
      "description": "A hit shape (ADR-009 §4). Each kind uses its own sizes; the others are 0.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "radius", "arcDegrees", "length", "width"],
      "properties": {
        "kind": { "type": "string", "enum": ["Circle", "Sector", "Rectangle"] },
        "radius": { "description": "Circle and Sector, in units.", "type": "number", "minimum": 0 },
        "arcDegrees": { "description": "Sector: the whole angle, in degrees.", "type": "number", "minimum": 0, "maximum": 360 },
        "length": { "description": "Rectangle: along the cast's direction, in units.", "type": "number", "minimum": 0 },
        "width": { "description": "Rectangle: across it, in units.", "type": "number", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "description": "Version of this file's format. A build reads exactly one version.",
      "type": "integer",
      "minimum": 1,
      "enum": [2]
    },
    "casting": {
      "description": "Rules every cast shares (Combat Bible §26).",
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "interruptedCooldownFraction"],
      "properties": {
        "provenance": { "description": "Combat Bible §49 lists the fraction.", "$ref": "#/definitions/provenance" },
        "interruptedCooldownFraction": {
          "description": "The part of its cooldown a cast starts when it is interrupted before Commit (Combat Bible §26).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "statuses": {
      "description": "Statuses abilities apply, keyed by their stable ID (Combat Bible §8, §46).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provenance", "kind", "stacking", "magnitude", "durationSeconds", "maxStacks", "takedownExtensionSeconds", "takedownExtensionMaxSeconds"],
          "properties": {
            "provenance": { "$ref": "#/definitions/provenance" },
            "kind": {
              "type": "string",
              "enum": ["Stun", "Slow", "MoveSpeed", "AttackSpeed", "Tenacity", "DamageReduction", "DisplacementResistance"]
            },
            "stacking": {
              "description": "Combat Bible §46.",
              "type": "string",
              "enum": ["UniqueRefresh", "UniqueReplaceStrongest", "Stacking", "IndependentSources"]
            },
            "magnitude": {
              "description": "Read as the kind says (EVeyraStatusKind): 0 for a Stun, the fraction of speed removed for a Slow, a signed change for Move Speed and Attack Speed, the fraction removed for the others.",
              "type": "number",
              "minimum": -1
            },
            "durationSeconds": { "description": "Before Tenacity, which shortens crowd control only.", "type": "number", "minimum": 0, "exclusiveMinimum": true },
            "maxStacks": { "type": "integer", "minimum": 1 },
            "takedownExtensionSeconds": { "description": "Seconds each takedown adds; 0 for none.", "type": "number", "minimum": 0 },
            "takedownExtensionMaxSeconds": { "description": "The most takedowns add in all.", "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "targetedDamage": {
      "description": "Abilities cast at one enemy that resolve at once and deal one damage component (Combat Bible §29 targeted, instant). test_bolt is the developer test ability (ADR-006 M3); its values are provisional.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["castRange", "cooldownSeconds", "resourceCost", "damageType", "damageAmount"],
          "properties": {
            "castRange": {
              "description": "Cast range in units, measured edge to edge (Combat Bible §40).",
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": true
            },
            "cooldownSeconds": {
              "description": "Cooldown in seconds, starting at Commit (Combat Bible §26).",
              "type": "number",
              "minimum": 0
            },
            "resourceCost": {
              "description": "Resource paid at Commit (Combat Bible §27).",
              "type": "number",
              "minimum": 0
            },
            "damageType": {
              "description": "The damage component's type (Combat Bible §2).",
              "type": "string",
              "enum": ["Physical", "Magic", "TrueDamage"]
            },
            "damageAmount": {
              "description": "Raw damage before any modifier (Combat Bible §25, step 2).",
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "area": {
      "description": "Abilities that hit the enemies in shapes at the caster or a ground point, at once, after a delay, or in channel ticks (ADR-008 §3).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provenance", "cast", "origin", "delaySeconds", "channelTicks", "channelSeconds", "zones"],
          "properties": {
            "provenance": { "$ref": "#/definitions/provenance" },
            "cast": { "$ref": "#/definitions/cast" },
            "origin": {
              "description": "Caster: on the caster, facing the cast's point. TargetPoint: on the point, facing away from the caster.",
              "type": "string",
              "enum": ["Caster", "TargetPoint"]
            },
            "delaySeconds": { "description": "Seconds between Commit and the hit, with the area telegraphed; the caster is free meanwhile.", "type": "number", "minimum": 0 },
            "channelTicks": { "description": "How many times the area hits over channelSeconds, the caster held in place.", "type": "integer", "minimum": 1 },
            "channelSeconds": { "type": "number", "minimum": 0 },
            "zones": {
              "description": "Innermost first: a unit takes the first zone that touches it, and no other.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["shape", "effects"],
                "properties": {
                  "shape": { "$ref": "#/definitions/shape" },
                  "effects": { "$ref": "#/definitions/effects" }
                }
              }
            }
          }
        }
      }
    },
    "selfBuff": {
      "description": "Abilities that buff their caster, and optionally nearby allied Vanguards (ADR-008 §3).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provenance", "cast", "statuses", "shields", "aura", "recast"],
          "properties": {
            "provenance": { "$ref": "#/definitions/provenance" },
            "cast": { "$ref": "#/definitions/cast" },
            "statuses": { "description": "Put on the caster.", "$ref": "#/definitions/statusIds" },
            "shields": {
              "description": "At most one shield on the caster (Combat Bible §7).",
              "type": "array",
              "minItems": 0,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["category", "amountByRank", "maxHealthRatio", "magicPowerRatio", "durationSeconds"],
                "properties": {
                  "category": { "type": "string", "enum": ["Physical", "Magic", "Universal"] },
                  "amountByRank": { "$ref": "#/definitions/byRank" },
                  "maxHealthRatio": { "description": "Of the caster's Max Health, added to the amount.", "type": "number", "minimum": 0 },
                  "magicPowerRatio": { "type": "number", "minimum": 0 },
                  "durationSeconds": { "type": "number", "minimum": 0, "exclusiveMinimum": true }
                }
              }
            },
            "aura": {
              "description": "At most one aura of statuses for nearby allied Vanguards (ADR-008 §9).",
              "type": "array",
              "minItems": 0,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["radius", "durationSeconds", "refreshSeconds", "allyStatuses"],
                "properties": {
                  "radius": { "description": "Units from the caster's centre to an ally's edge.", "type": "number", "minimum": 0, "exclusiveMinimum": true },
                  "durationSeconds": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
                  "refreshSeconds": { "description": "How often allies in range get the statuses again; the statuses should outlast it.", "type": "number", "minimum": 0, "exclusiveMinimum": true },
                  "allyStatuses": { "$ref": "#/definitions/statusIds" }
                }
              }
            },
            "recast": {
              "description": "EndsEarly: casting again while the buff lasts ends it, at no cost.",
              "type": "string",
              "enum": ["None", "EndsEarly"]
            }
          }
        }
      }
    }
  }
}
