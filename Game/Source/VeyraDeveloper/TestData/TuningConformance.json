{
  "description": "Documents that both tuning validators must judge the same way: the game's (VeyraTuning.cpp, test Veyra.Core.Tuning.ConformanceCorpus) and CI's (scripts/check_tuning.py, tests/test_tuning.py). Each document is raw text checked against TuningConformance.schema.json at schemaVersion 1.",
  "cases": [
    { "name": "valid", "valid": true, "document": "{\"schemaVersion\": 1, \"speed\": 12.5, \"count\": 3, \"nested\": {\"ratio\": 0.25}}" },
    { "name": "valid at the inclusive bounds", "valid": true, "document": "{\"schemaVersion\": 1, \"speed\": 1000, \"count\": 0, \"nested\": {\"ratio\": 0}}" },
    { "name": "valid with an integer-valued number", "valid": true, "document": "{\"schemaVersion\": 1, \"speed\": 7, \"count\": 10, \"nested\": {\"ratio\": 0.5}}" },
    { "name": "valid with a trailing newline", "valid": true, "document": "{\"schemaVersion\": 1, \"speed\": 1, \"count\": 1, \"nested\": {\"ratio\": 0.1}}\n" },
    { "name": "missing top-level field", "valid": false, "document": "{\"schemaVersion\": 1, \"speed\": 12.5, \"nested\": {\"ratio\": 0.25}}" },
    { "name": "missing nested field", "valid": false, "document": "{\"schemaVersion\": 1, \"speed\": 12.5, \"count\": 3, \"nested\": {}}" },
    { "name": "missing schemaVersion", "valid": false, "document": "{\"speed\": 12.5, \"count\": 3, \"nested\": {\"ratio\": 0.25}}" },
    { "name": "unknown top-level field", "valid": false, "document": "{\"schemaVersion\": 1, \"speed\": 12.5, \"count\": 3, \"nested\": {\"ratio\": 0.25}, \"speeds\": 2}" },
    { "name": "unknown nested field", "valid": false, "document": "{\"schemaVersion\": 1, \"speed\": 12.5, \"count\": 3, \"nested\": {\"ratio\": 0.25, \"extra\": 1}}" },
