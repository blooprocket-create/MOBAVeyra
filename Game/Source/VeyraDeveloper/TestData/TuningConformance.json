    { "name": "null for a number", "valid": false, "document": "{\"schemaVersion\": 1, \"speed\": null, \"count\": 3, \"nested\": {\"ratio\": 0.25}}" },
    { "name": "decimal for an integer", "valid": false, "document": "{\"schemaVersion\": 1, \"speed\": 12.5, \"count\": 1.0, \"nested\": {\"ratio\": 0.25}}" },
    { "name": "exponent for an integer", "valid": false, "document": "{\"schemaVersion\": 1, \"speed\": 12.5, \"count\": 1e1, \"nested\": {\"ratio\": 0.25}}" },
