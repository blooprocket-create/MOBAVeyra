    {"name": "valid with empty collections", "valid": true, "document": "{\"schemaVersion\": 1, \"home\": {\"x\": 0, \"name\": \"0000\"}, \"away\": {\"x\": 0, \"name\": \"0000\"}, \"extras\": [], \"byId\": {}}"},
    {"name": "a referenced field below its minimum", "valid": false, "document": "{\"schemaVersion\": 1, \"home\": {\"x\": -1, \"name\": \"00ff\"}, \"away\": {\"x\": 2, \"name\": \"abcd\"}, \"extras\": [], \"byId\": {}}"},
    {"name": "text outside the format through two references", "valid": false, "document": "{\"schemaVersion\": 1, \"home\": {\"x\": 1, \"name\": \"00FF\"}, \"away\": {\"x\": 2, \"name\": \"abcd\"}, \"extras\": [], \"byId\": {}}"},
    {"name": "a referenced record missing a field", "valid": false, "document": "{\"schemaVersion\": 1, \"home\": {\"x\": 1, \"name\": \"00ff\"}, \"away\": {\"x\": 2}, \"extras\": [], \"byId\": {}}"},
    {"name": "a referenced record with an unknown field", "valid": false, "document": "{\"schemaVersion\": 1, \"home\": {\"x\": 1, \"name\": \"00ff\", \"y\": 1}, \"away\": {\"x\": 2, \"name\": \"abcd\"}, \"extras\": [], \"byId\": {}}"},
    {"name": "an array item invalid through a reference", "valid": false, "document": "{\"schemaVersion\": 1, \"home\": {\"x\": 1, \"name\": \"00ff\"}, \"away\": {\"x\": 2, \"name\": \"abcd\"}, \"extras\": [{\"x\": 3, \"name\": \"xyz\"}], \"byId\": {}}"},
    {"name": "a map value invalid through a reference", "valid": false, "document": "{\"schemaVersion\": 1, \"home\": {\"x\": 1, \"name\": \"00ff\"}, \"away\": {\"x\": 2, \"name\": \"abcd\"}, \"extras\": [], \"byId\": {\"north\": {\"x\": \"far\", \"name\": \"ffff\"}}}"},
    {"name": "a number for a referenced record", "valid": false, "document": "{\"schemaVersion\": 1, \"home\": 5, \"away\": {\"x\": 2, \"name\": \"abcd\"}, \"extras\": [], \"byId\": {}}"},
    {"name": "a missing referenced record", "valid": false, "document": "{\"schemaVersion\": 1, \"home\": {\"x\": 1, \"name\": \"00ff\"}, \"extras\": [], \"byId\": {}}"}
