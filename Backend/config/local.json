{
  "environment": "local",
  "listenAddress": ":8080",
  "requestBodyLimitBytes": 65536,
  "http": {
    "readTimeout": "10s",
    "writeTimeout": "10s",
    "idleTimeout": "60s",
    "shutdownTimeout": "10s"
  },
  "sessions": {
    "launcherLifetime": "720h",
    "gameLifetime": "24h"
  },
  "launchCodes": {
    "lifetime": "20s"
  },
  "devLogin": {
    "enabled": true,
    "accounts": ["DevOne", "DevTwo", "DevThree", "DevFour", "DevFive", "DevSix", "DevSeven", "DevEight", "DevNine", "DevTen"]
  },
  "party": {
    "maxSize": 5,
    "inviteLifetime": "2m",
    "defaultPrivacy": "private"
  },
  "modes": [
    {"id": "casual_select", "enabled": true, "humanPlayersPerTeam": 1, "matchmaking": "casualSelect"},
    {"id": "draft_pick", "enabled": true, "humanPlayersPerTeam": 5, "matchmaking": "notImplemented"},
    {"id": "coop_beginner", "enabled": true, "humanPlayersPerTeam": 5, "matchmaking": "notImplemented"},
    {"id": "coop_intermediate", "enabled": true, "humanPlayersPerTeam": 5, "matchmaking": "notImplemented"},
    {"id": "ranked", "enabled": false, "humanPlayersPerTeam": 5, "matchmaking": "notImplemented"}
  ],
  "vanguards": {
    "released": ["cairn", "qazharr", "oriel", "bryn"],
    "starters": ["cairn", "qazharr", "oriel", "bryn"],
    "rotation": {"slots": 12, "standIn": "allReleased"}
  },
  "customPractice": {
    "enabled": true,
    "mode": "custom_practice",
    "hostSide": "A",
    "pickDuration": "30s",
    "playersPerSide": 5,
    "bots": [
      {"side": "B", "vanguardId": "cairn", "difficulty": "beginner"},
      {"side": "B", "vanguardId": "qazharr", "difficulty": "beginner"},
      {"side": "B", "vanguardId": "oriel", "difficulty": "beginner"},
      {"side": "B", "vanguardId": "bryn", "difficulty": "beginner"}
    ]
  },
  "matchmaking": {
    "interval": "1s",
    "searchLimit": 10000
  },
  "matchFound": {
    "acceptDuration": "15s"
  },
  "casualSelect": {
    "pickDuration": "60s",
    "presenceTimeout": "10s"
  },
  "selection": {
    "tickInterval": "1s",
    "startingTimeout": "60s"
  },
  "matches": {
    "devCreate": {"enabled": true},
    "readyTimeout": "120s",
    "maxDuration": "4h",
    "reapInterval": "5s",
    "removeServerAfter": "2m",
    "maps": {
      "play": "/Game/Veyra/World/Maps/L_Battleground",
      "development": "/Game/Veyra/Developer/Maps/L_Greybox"
    }
  },
  "allocator": {
    "kind": "docker",
    "docker": {
      "endpoint": "unix:///var/run/docker.sock",
      "apiVersion": "1.44",
      "requestTimeout": "30s",
      "image": "veyra-match-server:local",
      "network": "veyra_default",
      "containerNamePrefix": "veyra-match-",
      "containerPort": 7777,
      "hostPorts": {"min": 7780, "max": 7789},
      "hostIp": "127.0.0.1",
      "publicHost": "127.0.0.1",
      "backendUrl": "http://backend:8080",
      "serverArgs": ["-port=7777", "-log", "-stdout", "-FullStdOutLogOutput", "-LogCmds=LogVeyraAbilities Verbose"],
      "stopTimeout": "10s"
    }
  }
}
