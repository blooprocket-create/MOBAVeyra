{
  "environment": "local",
  "listenAddress": ":8080",
  "requestBodyLimitBytes": 65536,
  "http": {
    "readTimeout": "10s",
    "writeTimeout": "10s",
    "idleTimeout": "60s",
    "shutdownTimeout": "10s"
  },
  "sessions": {
    "launcherLifetime": "720h",
    "gameLifetime": "24h"
  },
  "launchCodes": {
    "lifetime": "20s"
  },
  "devLogin": {
    "enabled": true,
    "accounts": ["DevOne", "DevTwo", "DevThree", "DevFour", "DevFive", "DevSix", "DevSeven", "DevEight", "DevNine", "DevTen"]
  },
  "party": {
    "maxSize": 5,
    "inviteLifetime": "2m",
    "defaultPrivacy": "private"
  },
  "modes": [
    {"id": "casual_select", "enabled": true, "humanPlayersPerTeam": 5},
    {"id": "draft_pick", "enabled": true, "humanPlayersPerTeam": 5},
    {"id": "coop_beginner", "enabled": true, "humanPlayersPerTeam": 5},
    {"id": "coop_intermediate", "enabled": true, "humanPlayersPerTeam": 5},
    {"id": "ranked", "enabled": false, "humanPlayersPerTeam": 5}
  ]
}
